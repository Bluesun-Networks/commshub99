{
  "name": "commshub99",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:licenses": "node --import tsx tools/scripts/license-headers.ts",
    "db:generate": "bun run --filter @commshub99/db db:generate",
    "db:migrate": "bun run --filter @commshub99/db db:migrate",
    "db:seed": "bun run --filter @commshub99/db db:seed",
    "db:studio": "bun run --filter @commshub99/db db:studio",
    "fix:licenses": "node --import tsx tools/scripts/license-headers.ts --fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ]
}
